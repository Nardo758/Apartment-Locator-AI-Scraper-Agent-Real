{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
  "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
  "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    "test-claude-node.ts",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "scripts/*_deno.ts",
    "scripts/validate-config.ts",
    "scripts/*_deno/**/*.ts",
    "scripts/preview_weekly_batch_deno.ts",
    "scripts/preview_weekly_batch_deno.ts",
    "scripts/**/deno*.ts",
    "supabase/functions/**",
    "supabase/**/deno.json"
  ]
}
