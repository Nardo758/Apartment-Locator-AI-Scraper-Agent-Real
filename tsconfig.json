{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "test-claude-node.ts",
    "scripts/*.js",
    "scripts/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "scripts/**/*.ts",
    "src/**/*",
    "supabase/**/*",
    "agents/**/*",
    "data/**/*",
    "database/**/*",
    "app/**/*",
    "browser-extension/**/*",
    "command-station/**/*",
    "docs/**/*",
    "tmp/**/*",
    "types/**/*",
    "utils/**/*",
    "__tests__/**/*"
  ]
}
