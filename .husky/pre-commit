#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Check for secrets before commit
if command -v trufflehog > /dev/null 2>&1; then
  trufflehog git file://. --since-commit HEAD --only-verified --fail
fi

# Check file sizes
find . -type f -size +5M -not -path "./.git/*" -not -path "./node_modules/*" | grep -q . && {
  echo "❌ Files larger than 5MB detected. Please check .gitignore."
  exit 1
}
